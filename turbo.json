{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "@cp949/rx-bridge-electron#check-types": {
      "dependsOn": ["^check-types", "build"]
    },
    "@cp949/rx-bridge-electron#test": {
      "dependsOn": ["^test", "build"]
    },
    "verify": {
      "dependsOn": ["^verify"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
